t=0
while True :
    rate(250)
    t+=0.004
    titan.pos = vec (1500*sin(t), 1500*cos(t), t)
    s.pos = vec (-2500*sin(t), -2500*cos(t), t)
    Sun.pos = vec (15000*sin(t), 15000*cos(t), t)
    whole.pos = vec (1*sin(t), 1*cos(t), t)
    
    k=keysdown()
    

    
    if "q" in k:
        break
